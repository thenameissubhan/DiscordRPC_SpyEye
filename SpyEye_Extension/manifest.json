{
  "manifest_version": 3,

  "name": "SpyEye Extension",
  "description": "SpyEye Extension that seamlessly tracks and displays your browser action in real-time.",
  "version": "1.0",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}